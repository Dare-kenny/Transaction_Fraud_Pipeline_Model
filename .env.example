# ============================================================================
#  transaction-fraud-pipeline-model - example configuration
#  Copy to .env and adjust. Every value below is optional; the defaults shown
#  are what the app uses when a variable is absent.
#  The app has NO database: all state is in-memory, so there are no secrets
#  here by default. Keep the real .env out of git anyway (see .gitignore).
# ============================================================================

# ---- HTTP ------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---- Rule: amount threshold -----------------------------------------------
# Transactions strictly above this value raise a signal.
# Integer, in minor currency units (e.g. kobo/cents). Must be > 0.
FRAUD_AMOUNT_THRESHOLD=20000000

# ---- Rule: geography -------------------------------------------------------
# Comma-separated ISO 3166-1 alpha-2 codes. Must contain at least one entry.
FRAUD_GEO_ALLOWED=NG,GB,NZ,NL,AU,FR,DE,CA

# Optional override of the bundled (stub) IP -> country table.
# JSON array of { "cidr": "<ipv4>/<prefix>", "country": "<ISO2>" }.
# Longest matching prefix wins. Leave unset to use src/config/geo-ip.table.ts.
# FRAUD_GEO_IP_RANGES=[{"cidr":"102.89.0.0/16","country":"NG"}]

# ---- Rule: card blacklist --------------------------------------------------
# Comma-separated card numbers, 12-19 digits. Spaces/dashes are stripped.
# May be left empty to disable the rule.
FRAUD_BLACKLIST_CARDS=4111111111111111,4000000000000002

# ---- Rule: velocity (in-memory sliding window, per userId) -----------------
# More than MAX_ATTEMPTS requests from one user inside WINDOW_SECONDS signals.
FRAUD_VELOCITY_WINDOW_SECONDS=60
FRAUD_VELOCITY_MAX_ATTEMPTS=5
# Hard cap on tracked users, so the in-memory store cannot grow unbounded.
FRAUD_VELOCITY_MAX_TRACKED_KEYS=10000

# ---- Decision policy -------------------------------------------------------
# The accumulated score, and nothing else, decides the outcome:
#   score >= REJECT_THRESHOLD -> REJECTED
#   score >= REVIEW_THRESHOLD -> REVIEWING
#   otherwise                 -> APPROVED
# Requires 0 < REVIEW_THRESHOLD < REJECT_THRESHOLD.
FRAUD_SCORE_REVIEW_THRESHOLD=40
FRAUD_SCORE_REJECT_THRESHOLD=100

# ---- Signal weights (points added to the score) ---------------------------
FRAUD_WEIGHT_BLACKLISTED_CARD=100
FRAUD_WEIGHT_AMOUNT_OVER_THRESHOLD=50
FRAUD_WEIGHT_VELOCITY_LIMIT_EXCEEDED=60
FRAUD_WEIGHT_GEO_COUNTRY_NOT_ALLOWED=20
FRAUD_WEIGHT_GEO_IP_COUNTRY_MISMATCH=35
FRAUD_WEIGHT_GEO_IP_UNRESOLVED=10
